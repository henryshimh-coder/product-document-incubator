        <mxCell id="20" value="二、平台实际使用流程（六个工作区）" style="swimlane;startSize=40;container=1;pointerEvents=0;rounded=1;html=1;fillColor=#eff6ff;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="2020" height="500" as="geometry" />
