        <mxCell id="26" value="⑤ 变更发布&#xa;&#xa;自动生成变更单&#xa;人工检查并批准&#xa;任何 AI 建议不能自动生效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="20">
