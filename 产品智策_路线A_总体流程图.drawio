        <mxCell id="21" value="真实脱敏材料&#xa;&#xa;• 当前产品方案&#xa;• 风险意见&#xa;• 会议纪要&#xa;• 技术方案" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="20">
          <mxGeometry x="30" y="125" width="230" height="145" as="geometry" />
        </mxCell>
        <mxCell id="22" value="① 项目首页与当前基线&#xa;&#xa;先看清：&#xa;“现在生效的产品是什么”&#xa;版本、冲突、候选变化一屏掌握" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="20">
          <mxGeometry x="290" y="70" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="23" value="② 资料导入&#xa;&#xa;人工确认材料类型、权威和安全标签&#xa;AI 完成抽取、比较与知识编译" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="20">
          <mxGeometry x="590" y="70" width="250" height="150" as="geometry" />
