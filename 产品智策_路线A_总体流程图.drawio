        <mxCell id="27" value="新产品基线&#xa;&#xa;完整方案与规则卡同步更新&#xa;保留父版本、修改前后和批准记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="20">
