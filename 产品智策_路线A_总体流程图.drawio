        </mxCell>
        <mxCell id="25" value="④ 一键自检与会议决策&#xa;&#xa;发现跨材料、跨版本冲突&#xa;产品经理选择：接受／维持／暂缓／误报" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="20">
          <mxGeometry x="890" y="245" width="280" height="155" as="geometry" />
